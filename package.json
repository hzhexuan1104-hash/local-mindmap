{
  "name": "local-mindmap",
  "version": "1.24.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:release-ci": "vitest run scripts/ci/__tests__",
    "perf:mindmap": "vitest run src/features/mindmap/__tests__/performanceBenchmark.test.ts --silent=false",
    "native:build": "cargo build --manifest-path src-tauri/Cargo.toml --release --offline",
    "desktop:dev": "npm run build && npm run native:build && electron .",
    "desktop:build": "npm run build && npm run native:build && electron-builder --dir",
    "desktop:package": "npm run build && npm run native:build && electron-builder",
    "desktop:package:win7": "node scripts/build-win7.mjs",
    "desktop:smoke": "electron electron/smoke.cjs"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.9"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.localmindmap.desktop",
    "productName": "Local Mindmap",
    "directories": {
      "output": "release-electron"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/commands.json",
      "package.json",
      "src-tauri/icons/icon.png"
    ],
    "extraResources": [
      {
        "from": "src-tauri/target/release",
        "to": "native",
        "filter": [
          "local-mindmap-service",
          "local-mindmap-service.exe"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "lmind",
        "name": "Local Mindmap Document",
        "role": "Editor"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src-tauri/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "src-tauri/icons/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "src-tauri/icons/icon.icns"
    }
  },
  "description": "Offline local mindmap with bundled Chromium",
  "author": "local-mindmap contributors"
}
